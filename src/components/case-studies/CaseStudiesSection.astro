---
import { en } from '../../i18n/en';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (path: string) => `${baseUrl}${path.replace(/^\/+/, '')}`;
const blogUrl = (slug: string) => `${baseUrl}blog/${slug}/`;

const projectMeta = [
  {
    id: 'mirofish-ahp',
    tags: ['AI Agents', 'AHP', 'Decision Support', 'Wind Energy'],
    featured: true,
    color: '#2B5C3F',
    image: 'images/blog/mirofish/ahp_mirofish.jpg',
    alt: 'MiroFish-AHP pilot interface with multi-agent wind siting scenarios',
    slug: 'mirofish-ahp-multiagent-wind-siting',
    metric: '6 criteria',
    metricLabel: 'technical, social, environmental, and risk factors',
  },
  {
    id: 'foundation-change',
    tags: ['Foundation Models', 'Change Detection', 'Research'],
    featured: false,
    color: '#4A6FA5',
    image: 'images/blog/gfm-cd/OBJ3_llm_system.png?v=91cd8fc9',
    alt: 'Conversational geospatial analysis architecture for foundation-model change detection work in Chile',
    slug: 'geospatial-foundation-models-chile-change-detection',
  },
  {
    id: 'geo-llm',
    tags: ['LLM', 'PostGIS', 'FastAPI'],
    featured: false,
    color: '#C04A2E',
    image: 'images/blog/geo-llm/plataforma_geo-llm.png',
    alt: 'Geo-LLM mission control interface for batch address geocoding',
    slug: 'geo-llm-local-geocoding-pipeline-chile',
  },
  {
    id: 'spatial-sql',
    tags: ['Spatial SQL', 'DuckDB', 'Ollama'],
    featured: false,
    color: '#8C6D3F',
    image: 'images/blog/chat-sql/sql-chat.png',
    alt: 'Natural language spatial SQL interface showing a local chat-to-map workflow',
    slug: 'natural-language-spatial-sql-local-ai',
  },
  {
    id: 'security-indicators',
    tags: ['Public Policy', 'Security', 'KDE'],
    featured: false,
    color: '#2B5C3F',
    image: 'images/blog/mbht/dim_seguridad.png',
    alt: 'Security dimension visualization from the Territorial Human Wellbeing Matrix',
    slug: 'mbht-security-indicators-chile-2025',
  },
];

const projects = en.work.projects.map((project, index) => ({
  ...project,
  ...projectMeta[index],
  titleKey: `work.projects.${index}.title`,
  subtitleKey: `work.projects.${index}.subtitle`,
  descriptionKey: `work.projects.${index}.description`,
}));

const featuredProject = projects.find((project) => project.featured)!;
---

<section id="case-studies" class="relative py-0 bg-[#EEEAE4]">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 100%, rgba(43,92,63,0.04) 0%, transparent 60%);"
  ></div>

  <div class="relative z-10" style="max-width:1280px;margin-left:auto;margin-right:auto;padding-left:clamp(2rem,5vw,5rem);padding-right:clamp(2rem,5vw,5rem);">
    <!-- Header -->
    <div class="gsap-reveal mb-3 text-center">
      <span class="font-mono text-[#2B5C3F] text-xs tracking-[0.3em] uppercase">
        <span data-i18n="work.sectionNum">{en.work.sectionNum}</span>
      </span>
    </div>
    <div class="gsap-reveal mb-3 text-center">
      <h2 class="font-display font-semibold text-4xl md:text-5xl text-[#1A1917]">
        <span data-i18n="work.title">{en.work.title}</span>
      </h2>
    </div>
    <div class="gsap-reveal mb-8 text-center">
      <p class="text-[#6B6865] text-lg max-w-2xl mx-auto">
        <span data-i18n="work.description">{en.work.description}</span>
      </p>
    </div>

    <!-- Featured project -->
    <div
      class="gsap-reveal mb-8 group relative rounded-2xl overflow-hidden border border-black/7 bg-[#FDFCF9] hover:shadow-[0_8px_40px_rgba(0,0,0,0.08)] transition-all duration-500"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[240px]">
        <div class="relative h-56 lg:h-auto bg-[#1A1917] overflow-hidden">
          <img
            src={asset(featuredProject.image)}
            alt={featuredProject.alt}
            class="absolute inset-0 h-full w-full object-cover opacity-80"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-br from-[#1A1917]/80 via-[#1A1917]/25 to-[#2B5C3F]/40 pointer-events-none"></div>
          <div class="absolute inset-0 survey-grid opacity-20 pointer-events-none"></div>
          <div class="absolute left-5 bottom-5 rounded-lg border border-white/15 bg-black/35 px-4 py-3 backdrop-blur-sm">
            <div class="font-display font-bold text-white text-3xl leading-none">
              {featuredProject.metric}
            </div>
            <div class="font-mono text-white/70 text-xs mt-2 max-w-[14rem]">
              {featuredProject.metricLabel}
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="p-6 md:p-8 flex flex-col justify-center">
          <div
            class="inline-flex items-center gap-2 w-fit px-3 py-1 rounded-full border border-[#2B5C3F33] bg-[#2B5C3F08] text-[#2B5C3F] text-xs font-mono mb-5"
          >
            <span data-i18n="work.featured">{en.work.featured}</span>
          </div>
          <h3
            class="font-display font-semibold text-3xl md:text-4xl text-[#1A1917] mb-2 leading-tight"
          >
            <span data-i18n={featuredProject.titleKey}>{featuredProject.title}</span>
          </h3>
          <p class="text-[#6B6865] text-sm mb-4 font-mono" data-i18n={featuredProject.subtitleKey}>{featuredProject.subtitle}</p>
          <p class="text-[#6B6865] leading-relaxed mb-6">
            <span data-i18n={featuredProject.descriptionKey}>{featuredProject.description}</span>
          </p>
          <div class="flex flex-wrap gap-2 mb-7">
            {
              featuredProject.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded text-xs font-mono text-[#2B5C3F] border border-[#2B5C3F25] bg-[#2B5C3F08]">
                  {tag}
                </span>
              ))
            }
          </div>
          <a
            href={blogUrl(featuredProject.slug)}
            class="group/link inline-flex items-center gap-2 text-[#2B5C3F] font-semibold text-sm hover:gap-3 transition-all duration-200"
          >
            <span data-i18n="work.requestBtn">{en.work.requestBtn}</span>
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Project grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        projects
          .filter((p) => !p.featured)
          .map((project) => (
            <a
              href={blogUrl(project.slug)}
              class="project-card gsap-reveal group relative p-6 rounded-xl border border-black/7 bg-[#FDFCF9] hover:-translate-y-1.5 hover:shadow-[0_4px_20px_rgba(0,0,0,0.07)] transition-all duration-300"
            >
              <!-- Top accent line -->
              <div
                class="absolute top-0 left-0 right-0 h-0.5 rounded-t-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style={`background: ${project.color};`}
              />

              <div
                class="w-full h-32 rounded-lg mb-4 overflow-hidden relative bg-[#1A1917]"
              >
                <img
                  src={asset(project.image)}
                  alt={project.alt}
                  class="absolute inset-0 h-full w-full object-cover opacity-75 transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-br from-black/55 via-black/15 to-transparent" />
                <div class="absolute inset-0 survey-grid opacity-20" />
                <span
                  class="absolute left-3 bottom-3 font-mono text-[10px] uppercase tracking-wider opacity-80 z-10"
                  style={`color: ${project.color};`}
                >
                  {project.id.replace(/-/g, '_')}
                </span>
              </div>

              <h3 class="font-heading font-semibold text-[#1A1917] text-sm mb-1 leading-tight">
                <span data-i18n={project.titleKey}>{project.title}</span>
              </h3>
              <p class="text-[#6B6865] text-xs mb-3 font-mono" data-i18n={project.subtitleKey}>{project.subtitle}</p>
              <p class="text-[#6B6865] text-xs leading-relaxed mb-4 line-clamp-3">
                <span data-i18n={project.descriptionKey}>{project.description}</span>
              </p>
              <div class="flex flex-wrap gap-1.5">
                {project.tags.slice(0, 3).map((tag) => (
                  <span
                    class="px-1.5 py-0.5 rounded text-[10px] font-mono border"
                    style={`color: ${project.color}; border-color: ${project.color}25; background: ${project.color}08;`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('#case-studies .gsap-reveal').forEach((el) => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 88%',
        toggleActions: 'play none none none',
      },
    });
  });
</script>
